# Cliente de la cola Oracle: copiar variables a la configuración segura del backend.
# El daemon existente en Oracle VM es el único motor físico.
BACKUP_ENABLED=false
BACKUP_ENVIRONMENT=oracle-integracion-designada
BACKUP_CONTROL_DSN=postgresql://USUARIO_APP:CLAVE_URL_CODIFICADA@HOST_UBUNTU:5433/obratec_control?sslmode=require
# Mantener false: el daemon actual todavía no publica heartbeat compatible.
BACKUP_VM_HEARTBEAT_CONNECTED=false
BACKUP_VM_HEARTBEAT_MAX_AGE=120
# Metadatos públicos para validar el PAR generado por la VM; no son credenciales.
BACKUP_VM_OCI_NAMESPACE=grdnljcz1opp
BACKUP_VM_OCI_BUCKET=obratec_backups
# RESTORE está bloqueado en código en esta etapa, incluso si se cambia este flag.
BACKUP_RESTORE_ENABLED=false
# No configurar OCI secrets, S3, AES, discos, hooks o herramientas PostgreSQL en Render.
