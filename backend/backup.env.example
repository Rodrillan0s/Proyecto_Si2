# Copiar estas VARIABLES a la configuración del servidor. No contiene credenciales reales.
# No activar hasta migrar control y coordinar TODOS los escritores.
BACKUP_ENABLED=false
BACKUP_ENVIRONMENT=desarrollo-designado
BACKUP_CONTROL_DSN=postgresql://backup_control_user:REEMPLAZAR@localhost:5432/obratec_control
BACKUP_DIRECTORY=D:/OBRATEC_DATA/backups
BACKUP_STORAGE_PERSISTENT=false
BACKUP_EXTERNAL_WRITERS_COORDINATED=false
BACKUP_KEY_ID=key-2026-01
BACKUP_KEYS_JSON={}
BACKUP_PG_DUMP_PATH=
BACKUP_PG_RESTORE_PATH=
DB_SSLMODE=require
BACKUP_TIMEOUT_SECONDS=3600
BACKUP_MAX_BYTES=10737418240
BACKUP_MAX_FILES=100000
BACKUP_RESTORE_ENABLED=false
BACKUP_RESTORE_DSN=postgresql://restore_operator:REEMPLAZAR@localhost:5432/postgres
BACKUP_RELEASE_TARGET=
BACKUP_WORKER_EXTERNAL=false
# Arreglos JSON, ejecutable y argumentos explícitos. Sin shell ni comandos desde la API.
BACKUP_STOP_HOOK=[]
BACKUP_START_HOOK=[]
BACKUP_HEALTH_HOOK=[]
BACKUP_REHEARSAL_ENABLED=false
BACKUP_REHEARSAL_INTERVAL_DAYS=7
# Réplica fuera del host. Cadena estándar de credenciales AWS; bucket privado.
BACKUP_S3_BUCKET=
BACKUP_S3_PREFIX=obratec/
BACKUP_S3_ENDPOINT=
