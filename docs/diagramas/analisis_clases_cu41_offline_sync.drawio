        <mxCell id="title" value="&lt;b&gt;Diagrama de Análisis de Clases (BCE) — CU41: Gestionar Operación Offline y Sincronización&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;Historias de Usuario: HU90 (Consulta Offline), HU91 (Avances Offline), HU92 (Incidencias Offline), HU93 (Sync Automático), HU94 (Estado Sync)&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Arial;fontSize=12;fontColor=#000000;" vertex="1" parent="1">
