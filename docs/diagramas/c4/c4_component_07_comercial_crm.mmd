C4Component
    title Diagrama de Componentes C4 (Nivel 3) - Comercial y CRM

    %% 1. Contenedores consumidores (Arriba)
    Container(web, "Aplicación Web", "Angular 18 + Tailwind CSS", "Gestión de prospectos, unidades y pagos SaaS")
    Container(mobile, "Aplicación Móvil", "Flutter + Dart", "Consulta comercial de unidades")

    %% 2. Límite del Contenedor analizado (Centro)
    Container_Boundary(api, "API Backend [FastAPI + Uvicorn]") {
        Component(c1, "CRM Controller", "FastAPI Router", "Rutas de prospectos e interacciones (crm_routes.py)")
        Component(c2, "Unidades Controller", "FastAPI Router", "Catálogo de inmuebles y modelos (unidad_routes.py)")
        Component(c3, "Suscripción & Pagos Controller", "FastAPI Router", "Checkout Stripe y planes (pago_routes.py)")
        Component(s1, "CRM Service", "Python Service", "Embudo comercial y seguimiento (crm_services.py)")
        Component(s2, "Unidades Service", "Python Service", "Gestión de inmuebles y precios (unidad_services.py)")
        Component(s3, "Pagos & SaaS Service", "Python Service", "Cobros y renovación de planes (pago_services.py)")
        Component(a1, "Stripe Gateway Adapter", "Python Client", "Adaptador SDK Stripe (stripe_gateway.py)")
        Component(r1, "CRM Repository", "SQLAlchemy / PostgreSQL", "Clientes e interacciones (crm_repos.py)")
        Component(r2, "Unidades Repository", "SQLAlchemy / PostgreSQL", "Unidades y modelos (unidad_repos.py)")
        Component(r3, "Pagos Repository", "SQLAlchemy / PostgreSQL", "Planes y transacciones (pago_repos.py)")
    }

    %% 3. Persistencia y Sistemas Externos (Abajo)
    ContainerDb(db, "Base de Datos Principal", "PostgreSQL (schema: obras)", "Persiste t_crm_cliente, t_unidad_construccion, t_pago_suscripcion")
    System_Ext(stripe, "Stripe API", "Pasarela de pagos en línea")

    %% 4. Relaciones unidireccionales etiquetadas
    Rel(web, c1, "Gestiona prospectos", "JSON/HTTPS")
    Rel(web, c2, "Catálogo de unidades", "JSON/HTTPS")
    Rel(web, c3, "Pago de plan", "JSON/HTTPS")
    Rel(mobile, c2, "Consulta inmuebles", "JSON/HTTPS")
    Rel(c1, s1, "Delega CRM")
    Rel(c2, s2, "Delega unidades")
    Rel(c3, s3, "Delega pago")
    Rel(s3, a1, "Ejecuta cobro")
    Rel(a1, stripe, "HTTPS/REST")
    Rel(s1, r1, "Persiste cliente")
    Rel(s2, r2, "Persiste unidad")
    Rel(s3, r3, "Persiste pago")
    Rel(r1, db, "SQL/TCP")
    Rel(r2, db, "SQL/TCP")
    Rel(r3, db, "SQL/TCP")