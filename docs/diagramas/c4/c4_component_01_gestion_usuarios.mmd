C4Component
    title Diagrama de Componentes C4 (Nivel 3) - Gestión de Usuarios

    %% 1. Contenedores consumidores (Arriba)
    Container(web, "Aplicación Web", "Angular 18 + Tailwind CSS", "Interfaz web para administración de usuarios y roles")
    Container(mobile, "Aplicación Móvil", "Flutter + Dart", "App móvil para inicio de sesión de operadores")

    %% 2. Límite del Contenedor analizado (Centro)
    Container_Boundary(api, "API Backend [FastAPI + Uvicorn]") {
        Component(c1, "Auth & Recovery Controller", "FastAPI Router", "Login, refresh token y recuperación (auth_routes.py)")
        Component(c2, "Users & Roles Controller", "FastAPI Router", "Gestión de usuarios, roles y empresas (users_routes.py)")
        Component(s1, "Auth & Security Service", "Python Service", "Validación JWT, hash contraseñas y RBAC (auth_services.py)")
        Component(s2, "Users & Tenant Service", "Python Service", "Lógica multi-inquilino y perfiles (users_services.py)")
        Component(a1, "Email Brevo Adapter", "Python Client", "Envío de correos de recuperación (email_service.py)")
        Component(r1, "Auth & Users Repository", "SQLAlchemy / PostgreSQL", "Persistencia de usuarios, roles y seguridad (auth_repos.py)")
    }

    %% 3. Persistencia y Sistemas Externos (Abajo)
    ContainerDb(db, "Base de Datos Principal", "PostgreSQL (schema: obras)", "Persiste t_usuario, t_rol, t_empresa, t_persona")
    System_Ext(brevo, "Brevo API", "Servicio de correos transaccionales")

    %% 4. Relaciones unidireccionales etiquetadas
    Rel(web, c1, "Login y recuperación", "JSON/HTTPS")
    Rel(web, c2, "Administra usuarios y roles", "JSON/HTTPS")
    Rel(mobile, c1, "Autenticación móvil", "JSON/HTTPS")
    Rel(c1, s1, "Delega autenticación")
    Rel(c2, s2, "Delega perfiles")
    Rel(s1, a1, "Solicita envío de correo")
    Rel(a1, brevo, "HTTPS/REST")
    Rel(s1, r1, "Consulta credenciales")
    Rel(s2, r1, "Persiste usuario")
    Rel(r1, db, "SQL/TCP")