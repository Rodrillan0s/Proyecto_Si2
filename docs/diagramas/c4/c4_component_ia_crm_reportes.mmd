C4Component
    title Diagrama de Componentes - API Backend (Inteligencia Artificial, CRM y Reportes)

    %% 1. Contenedores consumidores (Arriba)
    Container(web, "Aplicación Web", "Angular 18 + Tailwind CSS", "Interfaz web para asistente comercial y reportería")
    Container(mobile, "Aplicación Móvil", "Flutter + Dart", "Consultas móviles al asistente y notificaciones")

    %% 2. Límite del Contenedor analizado (Centro)
    Container_Boundary(api, "API Backend [FastAPI + Uvicorn]") {
        Component(ai_ctrl, "AI & CRM Controller", "FastAPI Router", "Rutas para chat conversacional, sugerencias y CRM (ai_routes.py, crm_routes.py)")
        Component(rep_ctrl, "Reportes Controller", "FastAPI Router", "Rutas para generación, descarga y programación de reportes (reportes_routes.py)")

        Component(ai_srv, "AI Engine Service", "Python Service", "Orquestación de prompts, contexto de empresa y memoria (ai/ai_service.py)")
        Component(crm_srv, "CRM Service", "Python Service", "Gestión de prospectos, interacciones y calificación (crm_services.py)")
        Component(rep_srv, "Reportes Generator Service", "Python Service", "Compilación de métricas, exportación PDF/Excel y despachos (reportes_services.py)")

        Component(ai_adapter, "Gemini & Groq Adapter", "Python Client", "Adaptador SDK a modelos LLM para inferencia (ai/gemini_provider.py)")
        Component(brevo_adapter, "Reportes Email Adapter", "Python Client", "Distribución de reportes adjuntos por correo (reportes/worker.py)")

        Component(ai_repo, "Assistant Repository", "SQLAlchemy / Psycopg2", "Persistencia de sesiones de chat y mensajes (assistant_repos.py)")
        Component(crm_repo, "CRM Repository", "SQLAlchemy / Psycopg2", "Persistencia de clientes, interacciones y unidades (crm_repos.py)")
        Component(rep_repo, "Reportes Repository", "SQLAlchemy / Psycopg2", "Persistencia de ejecuciones, archivos y programaciones (reportes_repos.py)")
    }

    %% 3. Persistencia y Sistemas Externos (Abajo)
    ContainerDb(db, "Base de Datos Principal", "PostgreSQL (schema: obras)", "Persiste t_asistente_conversacion, t_crm_cliente, t_reporte_ejecucion")
    System_Ext(gemini, "Gemini / Groq API", "Servicio externo de inferencia con modelos LLM")
    System_Ext(brevo, "Brevo API", "Servicio externo de despacho de correos con adjuntos")

    %% 4. Relaciones unidireccionales etiquetadas
    Rel(web, ai_ctrl, "Interactúa con asistente y CRM", "JSON/HTTPS")
    Rel(mobile, ai_ctrl, "Realiza consultas comerciales", "JSON/HTTPS")
    Rel(web, rep_ctrl, "Solicita y programa reportes", "JSON/HTTPS")

    Rel(ai_ctrl, ai_srv, "Delega consulta conversacional")
    Rel(ai_ctrl, crm_srv, "Delega gestión de prospectos")
    Rel(rep_ctrl, rep_srv, "Solicita generación de reportes")

    Rel(ai_srv, ai_adapter, "Envía prompt enriquecido")
    Rel(ai_adapter, gemini, "Genera respuesta y análisis", "HTTPS/REST")

    Rel(rep_srv, brevo_adapter, "Envía reporte generado")
    Rel(brevo_adapter, brevo, "Despacha correo con PDF/Excel", "HTTPS/REST")

    Rel(ai_srv, ai_repo, "Almacena historial de mensajes")
    Rel(crm_srv, crm_repo, "Registra interacciones y estados")
    Rel(rep_srv, rep_repo, "Registra ejecuciones y logs")

    Rel(ai_repo, db, "Lee y escribe t_asistente_conversacion", "SQL/TCP")
    Rel(crm_repo, db, "Lee y escribe t_crm_cliente, t_interaccion", "SQL/TCP")
    Rel(rep_repo, db, "Lee y escribe t_reporte_ejecucion, t_archivo", "SQL/TCP")
