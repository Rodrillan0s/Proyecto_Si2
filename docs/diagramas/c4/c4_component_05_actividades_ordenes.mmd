C4Component
    title Diagrama de Componentes C4 (Nivel 3) - Actividades y Órdenes de Trabajo

    %% 1. Contenedores consumidores (Arriba)
    Container(web, "Aplicación Web", "Angular 18 + Tailwind CSS", "Planificación y asignación operativa")
    Container(mobile, "Aplicación Móvil", "Flutter + Dart", "Ejecución de órdenes e incidencias")

    %% 2. Límite del Contenedor analizado (Centro)
    Container_Boundary(api, "API Backend [FastAPI + Uvicorn]") {
        Component(c1, "Cronograma Controller", "FastAPI Router", "Rutas de planificación CU39 (cronograma_routes.py)")
        Component(c2, "Orden Trabajo Controller", "FastAPI Router", "Asignación de cuadrillas y tareas (orden_Trabajo_routes.py)")
        Component(c3, "Incidencias Controller", "FastAPI Router", "Registro de eventos e incidencias (incidencia_routes.py)")
        Component(s1, "Cronograma Service", "Python Service", "Diagrama de Gantt y dependencias (cronograma_services.py)")
        Component(s2, "Orden Trabajo Service", "Python Service", "Control de cuadrillas y ejecución (orden_Trabajo_services.py)")
        Component(s3, "Incidencias Service", "Python Service", "Resolución y evidencias multimedia (incidencia_services.py)")
        Component(a1, "Cloudinary Adapter", "Python Client", "Subida segura de fotos y planos (incidencia_services.py)")
        Component(r1, "Cronograma Repository", "SQLAlchemy / PostgreSQL", "Persistencia de hitos y tareas (cronograma_repos.py)")
        Component(r2, "Orden Trabajo Repository", "SQLAlchemy / PostgreSQL", "Persistencia de asignaciones de cuadrilla (orden_Trabajo_repos.py)")
        Component(r3, "Incidencias Repository", "SQLAlchemy / PostgreSQL", "Persistencia de incidencias y evidencias (incidencia_repos.py)")
    }

    %% 3. Persistencia y Sistemas Externos (Abajo)
    ContainerDb(db, "Base de Datos Principal", "PostgreSQL (schema: obras)", "Persiste t_cronograma, t_orden_trabajo, t_incidencia")
    System_Ext(cloudinary, "Cloudinary API", "Almacenamiento multimedia en la nube")

    %% 4. Relaciones unidireccionales etiquetadas
    Rel(web, c1, "Planifica cronograma", "JSON/HTTPS")
    Rel(web, c2, "Emite órdenes", "JSON/HTTPS")
    Rel(web, c3, "Monitorea incidencias", "JSON/HTTPS")
    Rel(mobile, c2, "Ejecuta órdenes", "JSON/HTTPS")
    Rel(mobile, c3, "Reporta incidencias", "JSON/HTTPS")
    Rel(c1, s1, "Delega cronograma")
    Rel(c2, s2, "Delega orden")
    Rel(c3, s3, "Delega incidencia")
    Rel(s3, a1, "Sube evidencias multimedia")
    Rel(a1, cloudinary, "HTTPS/REST")
    Rel(s1, r1, "Persiste tarea")
    Rel(s2, r2, "Persiste asignación")
    Rel(s3, r3, "Persiste incidencia")
    Rel(r1, db, "SQL/TCP")
    Rel(r2, db, "SQL/TCP")
    Rel(r3, db, "SQL/TCP")