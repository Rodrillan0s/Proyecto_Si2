C4Component
    title Diagrama de Componentes C4 (Nivel 3) - Gestión de Proyectos

    %% 1. Contenedores consumidores (Arriba)
    Container(web, "Aplicación Web", "Angular 18 + Tailwind CSS", "Administración de obras y estructuras")
    Container(mobile, "Aplicación Móvil", "Flutter + Dart", "Supervisión en terreno y avance")

    %% 2. Límite del Contenedor analizado (Centro)
    Container_Boundary(api, "API Backend [FastAPI + Uvicorn]") {
        Component(c1, "Obra & Estructura Controller", "FastAPI Router", "Rutas de proyectos y estructuras (obra_routes.py)")
        Component(c2, "Avance de Obra Controller", "FastAPI Router", "Registro de avances físicos (avance_routes.py)")
        Component(c3, "Consulta Técnica Controller", "FastAPI Router", "Ciclo de vida de RFIs (consulta_tecnica_routes.py)")
        Component(s1, "Obra Service", "Python Service", "Lógica de proyectos y jerarquías (obra_services.py)")
        Component(s2, "Avance Service", "Python Service", "Cálculo de avances acumulados (avance_services.py)")
        Component(s3, "Consulta Técnica Service", "Python Service", "Flujo de estados y respuestas RFI (consulta_tecnica_services.py)")
        Component(r1, "Proyectos Repository", "SQLAlchemy / PostgreSQL", "Persistencia de obras, frentes y avances (obra_repos.py)")
        Component(r2, "Consulta Técnica Repository", "SQLAlchemy / PostgreSQL", "Trazabilidad e historial de RFIs (consulta_tecnica_repos.py)")
    }

    %% 3. Persistencia y Sistemas Externos (Abajo)
    ContainerDb(db, "Base de Datos Principal", "PostgreSQL (schema: obras)", "Persiste t_obra, t_estructura, t_avance, t_consulta_tecnica")

    %% 4. Relaciones unidireccionales etiquetadas
    Rel(web, c1, "Gestiona proyectos", "JSON/HTTPS")
    Rel(web, c2, "Consulta avances", "JSON/HTTPS")
    Rel(web, c3, "Gestiona consultas RFI", "JSON/HTTPS")
    Rel(mobile, c1, "Consulta asignación", "JSON/HTTPS")
    Rel(mobile, c2, "Registra avance", "JSON/HTTPS")
    Rel(mobile, c3, "Reporta RFI", "JSON/HTTPS")
    Rel(c1, s1, "Delega proyecto")
    Rel(c2, s2, "Delega avance")
    Rel(c3, s3, "Delega RFI")
    Rel(s1, r1, "Persiste obra")
    Rel(s2, r1, "Persiste avance")
    Rel(s3, r2, "Persiste consulta")
    Rel(r1, db, "SQL/TCP")
    Rel(r2, db, "SQL/TCP")