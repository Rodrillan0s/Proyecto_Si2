C4Component
    title Diagrama de Componentes C4 (Nivel 3) - Reportes y Análisis

    %% 1. Contenedores consumidores (Arriba)
    Container(web, "Aplicación Web", "Angular 18 + Tailwind CSS", "Generación y visualización de reportes")
    Container(mobile, "Aplicación Móvil", "Flutter + Dart", "Descarga de reportes operativos")

    %% 2. Límite del Contenedor analizado (Centro)
    Container_Boundary(api, "API Backend [FastAPI + Uvicorn]") {
        Component(c1, "Reportes Controller", "FastAPI Router", "Rutas de generación y descarga PDF/Excel (reportes_routes.py)")
        Component(c2, "Notificaciones Controller", "FastAPI Router", "Alertas y auditoría del sistema (notificaciones_routes.py)")
        Component(s1, "Reportes Service", "Python Service", "Motor de reportes PDF/Excel (reportes_services.py)")
        Component(s2, "Notificaciones Service", "Python Service", "Gestión de eventos y bitácora (notificaciones_services.py)")
        Component(a1, "Brevo Dispatch Adapter", "Python Client", "Envío de reportes adjuntos (reportes/worker.py)")
        Component(r1, "Reportes Repository", "SQLAlchemy / PostgreSQL", "Persistencia de archivos y programaciones (reportes_repos.py)")
        Component(r2, "Notificaciones Repository", "SQLAlchemy / PostgreSQL", "Persistencia de alertas y bitácora (notificaciones_repos.py)")
    }

    %% 3. Persistencia y Sistemas Externos (Abajo)
    ContainerDb(db, "Base de Datos Principal", "PostgreSQL (schema: obras)", "Persiste t_reporte_ejecucion, notificacion, t_bitacora")
    System_Ext(brevo, "Brevo API", "Envío de correos y documentos adjuntos")

    %% 4. Relaciones unidireccionales etiquetadas
    Rel(web, c1, "Solicita reportes", "JSON/HTTPS")
    Rel(web, c2, "Consulta alertas", "JSON/HTTPS")
    Rel(mobile, c1, "Descarga PDF", "JSON/HTTPS")
    Rel(c1, s1, "Delega generación")
    Rel(c2, s2, "Delega notificación")
    Rel(s1, a1, "Programa despacho por email")
    Rel(a1, brevo, "HTTPS/REST")
    Rel(s1, r1, "Persiste archivo")
    Rel(s2, r2, "Persiste alerta")
    Rel(r1, db, "SQL/TCP")
    Rel(r2, db, "SQL/TCP")