C4Component
    title Diagrama de Componentes C4 (Nivel 3) - Presupuesto y Costos

    %% 1. Contenedores consumidores (Arriba)
    Container(web, "Aplicación Web", "Angular 18 + Tailwind CSS", "Gestión financiera, APU y costos")
    Container(mobile, "Aplicación Móvil", "Flutter + Dart", "Consulta de costos y estimaciones")

    %% 2. Límite del Contenedor analizado (Centro)
    Container_Boundary(api, "API Backend [FastAPI + Uvicorn]") {
        Component(c1, "Presupuesto & APU Controller", "FastAPI Router", "Rutas de partidas, APU e insumos (presupuesto_routes.py)")
        Component(c2, "Control Costos Controller", "FastAPI Router", "Costos ejecutados y estimaciones (control_costos_routes.py)")
        Component(s1, "Presupuesto & APU Service", "Python Service", "Cálculo de precios unitarios y partidas (presupuesto_services.py)")
        Component(s2, "Control Costos Service", "Python Service", "Desviaciones de costo y afectaciones (control_costos_services.py)")
        Component(r1, "Presupuesto Repository", "SQLAlchemy / PostgreSQL", "Persistencia de partidas y APUs (presupuesto_repos.py)")
        Component(r2, "Costos Repository", "SQLAlchemy / PostgreSQL", "Persistencia de costos y órdenes de cambio (control_costos_repos.py)")
    }

    %% 3. Persistencia y Sistemas Externos (Abajo)
    ContainerDb(db, "Base de Datos Principal", "PostgreSQL (schema: obras)", "Persiste t_presupuesto, t_partida, t_apu, t_control_costo")

    %% 4. Relaciones unidireccionales etiquetadas
    Rel(web, c1, "Administra presupuestos", "JSON/HTTPS")
    Rel(web, c2, "Audita costos finales", "JSON/HTTPS")
    Rel(mobile, c2, "Consulta costos en obra", "JSON/HTTPS")
    Rel(c1, s1, "Delega presupuesto")
    Rel(c2, s2, "Delega liquidación")
    Rel(s1, r1, "Persiste partida")
    Rel(s2, r2, "Persiste costo ejecutado")
    Rel(r1, db, "SQL/TCP")
    Rel(r2, db, "SQL/TCP")