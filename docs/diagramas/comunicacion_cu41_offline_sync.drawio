          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge_services_repos" value="14. transaccionLote() →&lt;br&gt;(inserción atómica &amp; auditoría)" style="endArrow=classic;html=1;rounded=0;strokeColor=#000000;strokeWidth=1.2;fontSize=9;fontColor=#000000;fontFamily=Arial;labelPosition=center;verticalLabelPosition=top;verticalAlign=bottom;" edge="1" parent="1" source="c_sync_services" target="c_sync_repos">
