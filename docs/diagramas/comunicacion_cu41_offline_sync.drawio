        <mxCell id="edge_user_iu" value="1. consultarInfoObra() [HU90] →&lt;br&gt;5. registrarAvance/Incidencia() [HU91/92] →&lt;br&gt;8. consultarEstadoSync() [HU94] →&lt;br&gt;← 9. mostrarEstadoLocal()&lt;br&gt;← 18. notificarSincronizacion()" style="endArrow=none;html=1;rounded=0;strokeColor=#000000;strokeWidth=1.2;fontSize=9;fontColor=#000000;fontFamily=Arial;labelPosition=center;verticalLabelPosition=top;verticalAlign=bottom;" edge="1" parent="1" source="actor_user" target="b_iu">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge_iu_mgr" value="2. leerCacheObra() →&lt;br&gt;6. guardarOffline(PENDIENTE) →&lt;br&gt;← 4. returnInfoObraCache()&lt;br&gt;← 18a. callbackSyncCompletado()" style="endArrow=classic;html=1;rounded=0;strokeColor=#000000;strokeWidth=1.2;fontSize=9;fontColor=#000000;fontFamily=Arial;labelPosition=center;verticalLabelPosition=top;verticalAlign=bottom;" edge="1" parent="1" source="b_iu" target="c_sync_mgr">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge_mgr_sqlite" value="3. SELECT cache_obra ↓&lt;br&gt;7. INSERT cola_sync (PENDIENTE) ↓&lt;br&gt;11. SELECT WHERE estado=PENDIENTE ↓&lt;br&gt;17. UPDATE estado=SINCRONIZADO ↓" style="endArrow=classic;html=1;rounded=0;strokeColor=#000000;strokeWidth=1.2;fontSize=8.5;fontColor=#000000;fontFamily=Arial;labelPosition=right;verticalLabelPosition=middle;align=left;spacingLeft=10;" edge="1" parent="1" source="c_sync_mgr" target="e_sqlite">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge_sqlite_cache" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#000000;strokeWidth=1.2;" edge="1" parent="1" source="e_sqlite" target="e_cache_obra">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge_sqlite_cola" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#000000;strokeWidth=1.2;" edge="1" parent="1" source="e_sqlite" target="e_cola_sync">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge_mgr_routes" value="10. [Conexión Recuperada / HU93]&lt;br&gt;12. POST /api/v1/sync/batch (lote_json) →&lt;br&gt;← 16. 200 OK (ids_confirmados, timestamp)" style="endArrow=classic;html=1;rounded=0;strokeColor=#000000;strokeWidth=1.5;strokeDasharray=4 3;fontSize=9;fontColor=#000000;fontFamily=Arial;labelPosition=center;verticalLabelPosition=top;verticalAlign=bottom;" edge="1" parent="1" source="c_sync_mgr" target="c_sync_routes">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
